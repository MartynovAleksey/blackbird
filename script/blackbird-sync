#!/usr/bin/env bash
# Обновление текущей линии blackbird из апстрима: merge апстрим-ветки и проверка ребрендинга.
# blackbird/v1 <- upstream/v1, blackbird/v2 <- upstream/dev. При конфликте merge остаётся незакоммиченным.
# usage: script/blackbird-sync   (в worktree нужной линии)
set -euo pipefail
cd "$(dirname "$0")/.."

branch=$(git symbolic-ref --short HEAD)
case "$branch" in
  blackbird/v1) up=v1 ;;
  blackbird/v2) up=dev ;;
  *) echo "текущая ветка $branch — не blackbird/v1 или blackbird/v2" >&2; exit 1 ;;
esac
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "есть незакоммиченные изменения" >&2; exit 1; }

git fetch upstream "$up"
if ! git merge --no-edit "upstream/$up"; then
  echo "Конфликты с upstream/$up — разрешите, закоммитьте и запустите script/blackbird-check.sh:" >&2
  git diff --name-only --diff-filter=U >&2
  exit 1
fi
bun install
script/blackbird-check.sh
