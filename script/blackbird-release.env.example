# Сетевые настройки образа-сборщика: скопируйте, раскомментируйте нужное и передайте при запуске
#   docker run --env-file blackbird-release.env ... blackbird-builder
# Формат docker --env-file: КЛЮЧ=значение без кавычек, строки с # — комментарии.
# Те же переменные можно передать и напрямую: docker run -e HTTPS_PROXY=... -e NPM_CONFIG_REGISTRY=...

# Корпоративный HTTP(S)-прокси
#HTTPS_PROXY=http://proxy.example.com:3128
#HTTP_PROXY=http://proxy.example.com:3128
#NO_PROXY=localhost,127.0.0.1

# Корпоративное зеркало npm (Nexus, Artifactory и т. п.)
#NPM_CONFIG_REGISTRY=https://nexus.example.com/repository/npm/

# Не проверять TLS-сертификаты, если сеть их подменяет (ошибка SELF_SIGNED_CERT_IN_CHAIN).
# Целостность пакетов всё равно сверяется с хешами в bun.lock.
#NODE_TLS_REJECT_UNAUTHORIZED=0
